# =====================================================================
#  .env.example  —  sirf NAMOONA (template). Is mein asal keys NAHI hain.
#
#  Istemal ka tareeqa:
#    1. Is file ki copy banayein:   cp .env.example .env
#    2. .env mein apni keys likhein.
#    3. .env kabhi GitHub par nahi jaayegi (.gitignore mein hai).
#
#  KHABARDAR: asal key kabhi chat, screenshot ya GitHub par share na karein.
# =====================================================================

# ---------- Phase 2: AI Script (OPTIONAL, PAID) ----------
# Agar khaali chhor dein to system FREE mode mein chalega: aap ko ek
# ready prompt milega jo aap claude.ai ki chat mein paste kar sakte hain.
# Key yahan se milti hai: https://console.anthropic.com  (Settings → API Keys)
# Lagat (andaza): ek script ≈ $0.05 – $0.15  (tafseel README mein)
ANTHROPIC_API_KEY=

# Kaun sa Claude model istemal ho (default theek hai, badalne ki zaroorat nahi)
CLAUDE_MODEL=claude-opus-5-5

# ---------- Phase 6 (abhi ISTEMAL NAHI HOTE — sirf aage ke liye) ----------
# Social media APIs abhi connect nahi hain. Yeh khaali hi rahein.
# YOUTUBE_CLIENT_SECRET_FILE=
# FACEBOOK_PAGE_ID=
# FACEBOOK_PAGE_ACCESS_TOKEN=
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
