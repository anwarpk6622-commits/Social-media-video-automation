# =====================================================================
#  .gitignore  —  yeh files GitHub par KABHI upload nahi hongi
# =====================================================================

# ---------- 1. Secrets (API keys, passwords, tokens) ----------
.env
.env.*
!.env.example
*.key
*.pem
client_secret*.json
credentials*.json
token*.json
secrets/

# ---------- 2. Aap ki recordings aur videos (privacy + size) ----------
# Projects ke andar har qisam ka media aur generated output ignore hai.
projects/*/input/
projects/*/audio/
projects/*/subtitles/*.wav
projects/*/output/
projects/*/preview/
projects/*/tmp/
projects/font_test.png
# Phase 6: resumable-upload sessions (can act like a key) + simulation runs
projects/*/publish/private/
projects/*/publish/simulations/
projects/*/publish/jobs/*.lock
projects/*/publish/jobs/*.tmp

# Media files kahin bhi (siwaye assets/ ke, jahan licensed music/sfx rakh sakte hain)
*.wav
*.mp3
*.m4a
*.aac
*.flac
*.ogg
*.opus
*.mp4
*.mov
*.mkv
*.avi
*.webm
*.3gp
!assets/**/*.wav
!assets/**/*.mp3
!assets/**/*.m4a
!assets/**/*.mp4

# ---------- 2b. AI models (bari files, khud download hoti hain) ----------
models/

# ---------- 3. Node.js ----------
node_modules/
package-lock.json

# ---------- 4. Python ----------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# ---------- 5. System / editor ----------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.log
