{
  "channel": {
    "name": "My Urdu Channel",
    "language": "ur",
    "audience": "Pakistani aur Urdu bolne wale aam log",
    "tone": "dostana, saaf aur professional",
    "call_to_action": "Video pasand aaye to like karein, channel subscribe karein aur bell icon dabayein."
  },

  "script": {
    "default_minutes": 3,
    "words_per_minute": 130,
    "model": "claude-opus-5-5",
    "effort": "medium",
    "max_output_tokens": 16000,
    "price_per_million_input_usd": 4.0,
    "price_per_million_output_usd": 20.0
  },

  "audio": {
    "sample_rate": 48000,
    "target_lufs": -14.0,
    "true_peak_db": -1.5,
    "loudness_range": 11.0,
    "max_limiting_db": 3.0,
    "highpass_hz": 80,
    "noise_reduction": "medium",
    "eq": true,
    "deesser": true,
    "compressor": true,
    "trim_silence": false,
    "silence_threshold_db": -45,
    "max_silence_seconds": 0.8,
    "keep_silence_seconds": 0.35
  },

  "subtitles": {
    "model": "medium",
    "use_script_hint": false,
    "min_script_match": 0.2,
    "highlight_words": true,
    "colors": { "text": "#FFFFFF", "highlight": "#FFD60A", "outline": "#000000" },
    "landscape": {
      "width": 1920, "height": 1080, "font_size": 62, "bottom": 60, "max_width": 1500, "box": false,
      "max_chars": 48, "max_words": 10, "max_seconds": 5.5, "min_seconds": 1.0, "gap_split": 0.7,
      "srt_line_chars": 42
    },
    "vertical": {
      "width": 1080, "height": 1920, "font_size": 84, "bottom": 560, "max_width": 860, "box": false,
      "max_chars": 22, "max_words": 4, "max_seconds": 3.0, "min_seconds": 0.7, "gap_split": 0.5,
      "srt_line_chars": 24
    }
  },

  "fonts": {
    "urdu_regular": "assets/fonts/NotoNastaliqUrdu-Regular.ttf",
    "urdu_bold": "assets/fonts/NotoNastaliqUrdu-Bold.ttf",
    "urdu_family": "Noto Nastaliq Urdu"
  }
}
