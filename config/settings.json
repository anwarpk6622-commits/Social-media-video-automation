{
  "channel": {
    "name": "My Urdu Channel",
    "language": "ur",
    "audience": "Pakistani aur Urdu bolne wale aam log",
    "tone": "dostana, saaf aur professional",
    "call_to_action": "Video pasand aaye to like karein, channel subscribe karein aur bell icon dabayein."
  },

  "script": {
    "default_minutes": 3,
    "words_per_minute": 130,
    "model": "claude-opus-5-5",
    "effort": "medium",
    "max_output_tokens": 16000,
    "price_per_million_input_usd": 4.0,
    "price_per_million_output_usd": 20.0
  },

  "audio": {
    "sample_rate": 48000,
    "target_lufs": -14.0,
    "true_peak_db": -1.5,
    "loudness_range": 11.0,
    "max_limiting_db": 3.0,
    "highpass_hz": 80,
    "noise_reduction": "medium",
    "eq": true,
    "deesser": true,
    "compressor": true,
    "trim_silence": false,
    "silence_threshold_db": -45,
    "max_silence_seconds": 0.8,
    "keep_silence_seconds": 0.35
  },

  "subtitles": {
    "model": "medium",
    "use_script_hint": false,
    "min_script_match": 0.2,
    "highlight_words": true,
    "colors": { "text": "#FFFFFF", "highlight": "#FFD60A", "outline": "#000000" },
    "landscape": {
      "width": 1920, "height": 1080, "font_size": 62, "bottom": 60, "max_width": 1500, "box": false,
      "max_chars": 48, "max_words": 10, "max_seconds": 5.5, "min_seconds": 1.0, "gap_split": 0.7,
      "srt_line_chars": 42
    },
    "vertical": {
      "width": 1080, "height": 1920, "font_size": 84, "bottom": 560, "max_width": 860, "box": false,
      "max_chars": 22, "max_words": 4, "max_seconds": 3.0, "min_seconds": 0.7, "gap_split": 0.5,
      "srt_line_chars": 24
    }
  },

  "fonts": {
    "urdu_regular": "assets/fonts/NotoNastaliqUrdu-Regular.ttf",
    "urdu_bold": "assets/fonts/NotoNastaliqUrdu-Bold.ttf",
    "urdu_family": "Noto Nastaliq Urdu"
  },

  "publishing": {
    "call_to_action_ur": "ویڈیو پسند آئے تو لائک کریں، چینل سبسکرائب کریں اور بیل آئیکن دبائیں۔",
    "follow_line_ur": "ایسی مزید ویڈیوز کے لیے فالو کریں۔",
    "extra_hashtags": [],
    "platforms": {
      "youtube":        { "title_max": 100, "title_ideal": 70, "description_max": 5000, "hashtags_max": 15, "tags_chars_max": 500 },
      "youtube_shorts": { "title_max": 100, "title_ideal": 60, "description_max": 5000, "hashtags_max": 15 },
      "facebook_reels": { "caption_max": 2200, "caption_ideal": 125, "hashtags_ideal": 5 },
      "tiktok":         { "caption_max": 2200, "caption_ideal": 150, "hashtags_ideal": 5 }
    },
    "thumbnail": { "youtube_size": [1280, 720], "cover_size": [1080, 1920], "max_bytes": 2000000 },
    "live_enabled": false,
    "_live_enabled_note": "Phase 6.1: false = koi asal upload mumkin nahi. Sirf aap ki manzoori se (Phase 6.2+) badlega.",
    "retry": { "max_attempts": 5, "base_delay_seconds": 1.0, "max_delay_seconds": 60.0 }
  }
}
